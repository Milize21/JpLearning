{
  "realm": "nomax",
  "displayName": "NomaX JP Learn",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "passwordPolicy": "length(8) and notUsername(undefined)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "id",
    "en"
  ],
  "defaultLocale": "id",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Community administrator: accounts, content structure, built-in question bank, seasons"
      },
      {
        "name": "sensei",
        "description": "Teacher: manages the classes they teach"
      },
      {
        "name": "murid",
        "description": "Student: accesses the classes they belong to"
      }
    ]
  },
  "clients": [
    {
      "clientId": "nomax-web",
      "name": "NomaX JP Learn (web)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "audience-nomax-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "nomax-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "nomax-api",
      "name": "NomaX JP Learn (API)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${NOMAX_API_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "id": "a0000000-0000-4000-8000-000000000001",
      "username": "admin.dev",
      "email": "admin.dev@nomax.test",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Dev",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "Nomax-dev-admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-nomax",
        "admin"
      ]
    },
    {
      "id": "a0000000-0000-4000-8000-000000000002",
      "username": "sensei.dev",
      "email": "sensei.dev@nomax.test",
      "emailVerified": true,
      "firstName": "Sensei",
      "lastName": "Dev",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "Nomax-dev-sensei",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-nomax",
        "sensei"
      ]
    },
    {
      "id": "a0000000-0000-4000-8000-000000000003",
      "username": "murid1.dev",
      "email": "murid1.dev@nomax.test",
      "emailVerified": true,
      "firstName": "Murid",
      "lastName": "Satu",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "Nomax-dev-murid1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-nomax",
        "murid"
      ]
    },
    {
      "id": "a0000000-0000-4000-8000-000000000004",
      "username": "murid2.dev",
      "email": "murid2.dev@nomax.test",
      "emailVerified": true,
      "firstName": "Murid",
      "lastName": "Dua",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "Nomax-dev-murid2",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-nomax",
        "murid"
      ]
    },
    {
      "username": "service-account-nomax-api",
      "enabled": true,
      "serviceAccountClientId": "nomax-api",
      "realmRoles": [
        "default-roles-nomax"
      ],
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
