# Copy to infra/.env and replace every "change-me" value. infra/.env is never committed.
# The API reads the same PostgreSQL credentials from user-secrets (see infra/README.md).

POSTGRES_USER=nomax
POSTGRES_PASSWORD=change-me

# Keycloak master-realm administrator (admin console at http://localhost:8081).
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Client secret of the confidential client "nomax-api" (Keycloak Admin API, used from Phase 0.2).
NOMAX_API_CLIENT_SECRET=change-me

# Optional: host ports when 5432/6379 are already taken on your machine (defaults 5432 and 6379).
# Remember to point the API connection strings at the same ports (infra/README.md).
# POSTGRES_PORT=5433
# VALKEY_PORT=6380
