{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Audience": "nomax-api"
  },
  "RateLimiting": {
    "PerUserPerMinute": 300,
    "IcalPerIpPerMinute": 60
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "hubs": {
        "ClusterId": "api",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/hubs/{**catch-all}" }
      },
      "signed-files": {
        "ClusterId": "api",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/content/files/{id}/content" }
      },
      "ical": {
        "ClusterId": "api",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "ical",
        "Match": { "Path": "/ical/{**catch-all}" }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api": { "Address": "http://localhost:5080/" }
        }
      }
    }
  }
}
