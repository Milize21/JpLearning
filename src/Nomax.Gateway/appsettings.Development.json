{
  "Keycloak": {
    "Authority": "http://localhost:8081/realms/nomax",
    "RequireHttpsMetadata": false
  },
  "ReverseProxy": {
    "Routes": {
      "openapi": {
        "ClusterId": "api",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/openapi/{**catch-all}" }
      },
      "scalar": {
        "ClusterId": "api",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/scalar/{**catch-all}" }
      }
    }
  }
}
