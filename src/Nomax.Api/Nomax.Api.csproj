<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Composition root of the modular monolith (docs/02 §2): loads every module. -->
  <PropertyGroup>
    <RootNamespace>Nomax.Api</RootNamespace>
    <UserSecretsId>nomax-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Design-time only: lets dotnet-ef build migrations with this host as startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks\Nomax.BuildingBlocks\Nomax.BuildingBlocks.csproj" />
    <ProjectReference Include="..\Modules\Identity\Nomax.Modules.Identity\Nomax.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Content\Nomax.Modules.Content\Nomax.Modules.Content.csproj" />
    <ProjectReference Include="..\Modules\Classroom\Nomax.Modules.Classroom\Nomax.Modules.Classroom.csproj" />
    <ProjectReference Include="..\Modules\Practice\Nomax.Modules.Practice\Nomax.Modules.Practice.csproj" />
  </ItemGroup>
</Project>
